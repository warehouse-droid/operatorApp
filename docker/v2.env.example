# Copy this template to docker/env/.env.old for the independent port-3099 stack.
PORT=3000
APP_BASE_URL=http://localhost:3099
DATABASE_URL=postgres://mbbs_app:replace-me@db:5432/mbbs_yard_v2

POSTGRES_USER=mbbs_app
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=mbbs_yard_v2

DISPATCH_DRIVER_ORIENTED_PLANNING=true
# Independent server-side rollout gates: off, shadow, or on.
DISPATCH_PLANNER_ORDER_POOL_MODE=off
DISPATCH_PLANNER_COMMAND_MODE=off
DRIVER_ROUTE_PUSH_VAPID_PUBLIC_KEY=
DRIVER_ROUTE_PUSH_VAPID_PRIVATE_KEY=
DRIVER_ROUTE_PUSH_VAPID_SUBJECT=mailto:operations@example.com
# Temporary no-login mode for /sales; set false to restore Sales authentication.
SALES_PUBLIC_ACCESS_ENABLED=true

# Port 3099 is independent. No data relay runs between 3000 and 3099.
NETSUITE_MIRROR_ROLE=disabled
NETSUITE_MIRROR_SHARED_SECRET=
NETSUITE_MIRROR_SOURCE_URL=
NETSUITE_MIRROR_CONSUMER_URL=

# Direct access is available only after a separate OAuth login on port 3099.
NETSUITE_DIRECT_ACCESS_ENABLED=true
NETSUITE_ACCOUNT_ID=
NETSUITE_CLIENT_ID=
NETSUITE_CLIENT_SECRET=
NETSUITE_REDIRECT_URI=http://localhost:3099/api/auth/netsuite/callback
NETSUITE_AUTH_URL=
NETSUITE_TOKEN_URL=
NETSUITE_REST_BASE_URL=
NETSUITE_M2M_STORAGE_SECRET=
NETSUITE_M2M_SETTINGS_PATH=/app/data/netsuite-m2m-settings.json
NETSUITE_M2M_MASTER_KEY_PATH=/app/data/.netsuite-m2m-master-key
NETSUITE_WEBHOOK_SECRET=

# Keep external write paths blocked on the secondary local instance.
SAMSARA_API_TOKEN=
SAMSARA_DVIR_AUTHOR_ID=
SAMSARA_WRITES_ENABLED=false
SMART_SCM_LIVE_EXECUTION_ENABLED=false

# V2 photo proofs remain in its isolated database; no R2 worker writes.
PHOTO_UPLOAD_PROVIDER=local_data_url
PHOTO_UPLOAD_WORKER_URL=
PHOTO_UPLOAD_TOKEN_SECRET=
PHOTO_UPLOAD_PUBLIC_BASE_URL=

GOOGLE_MAPS_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b-instruct
