PORT=3000
APP_BASE_URL=http://localhost:3099
DATABASE_URL=postgres://mbbs_app:replace-me@db:5432/mbbs_yard_v2

POSTGRES_USER=mbbs_app
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=mbbs_yard_v2

DISPATCH_DRIVER_ORIENTED_PLANNING=true

# V2 obtains every NetSuite-backed update from the current application.
NETSUITE_MIRROR_ROLE=consumer
NETSUITE_MIRROR_SHARED_SECRET=replace-with-the-same-long-random-secret-as-port-3000
NETSUITE_MIRROR_SOURCE_URL=http://mbbs-current-app:3000
NETSUITE_MIRROR_CONSUMER_URL=
NETSUITE_MIRROR_RELAY_INTERVAL_MS=5000
NETSUITE_MIRROR_POLL_INTERVAL_MS=30000
NETSUITE_MIRROR_RECONCILE_INTERVAL_MS=21600000
NETSUITE_MIRROR_REQUEST_TIMEOUT_MS=15000
NETSUITE_MIRROR_SIGNATURE_MAX_AGE_SECONDS=300
NETSUITE_MIRROR_PAGE_SIZE=100

# Defense in depth: all direct NetSuite HTTP calls are rejected in code.
NETSUITE_DIRECT_ACCESS_ENABLED=false
NETSUITE_ACCOUNT_ID=
NETSUITE_CLIENT_ID=
NETSUITE_CLIENT_SECRET=
NETSUITE_REDIRECT_URI=
NETSUITE_AUTH_URL=
NETSUITE_TOKEN_URL=
NETSUITE_REST_BASE_URL=
NETSUITE_WEBHOOK_SECRET=

# Samsara reads may be enabled later with a token, but writes remain blocked.
SAMSARA_API_TOKEN=
SAMSARA_DVIR_AUTHOR_ID=
SAMSARA_WRITES_ENABLED=false

# V2 photo proofs remain in its isolated database; no R2 worker writes.
PHOTO_UPLOAD_PROVIDER=local_data_url
PHOTO_UPLOAD_WORKER_URL=
PHOTO_UPLOAD_TOKEN_SECRET=
PHOTO_UPLOAD_PUBLIC_BASE_URL=

GOOGLE_MAPS_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b-instruct
