+
+test("queued work cannot run before its owner completes and enqueue is idempotent", async () => {
+  const f = await fixture();
+  await enqueuePostingPhotos({ commandId: f.id, photos: [...photos].sort() });
+  await enqueuePostingPhotos({ commandId: f.id, photos: [...photos].sort() });
