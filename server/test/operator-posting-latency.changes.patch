+    const lines = readFileSync(file, "utf8").match(/[^\n]*\n|[^\n]+$/g) || [];
+    for (const edit of [...entry.edits].reverse()) {lines.splice(edit.start, edit.end - edit.start, ...edit.before);}
+    const text = lines.join("");
