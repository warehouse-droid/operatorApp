diff --git a/server/src/scm-dependency-plan-reconciler.js b/server/src/scm-dependency-plan-reconciler.js
--- a/server/src/scm-dependency-plan-reconciler.js
+++ b/server/src/scm-dependency-plan-reconciler.js
@@ -120,7 +120,10 @@
     ...stop,
     type: "drop",
     orderId: text(order.id),
-    location: destinationYard || address,
+    // A planner-created PO drop keeps its vendor pickup reference in
+    // `location`; the destination is dropLocation/dropAddress. Rewriting it
+    // made every autosave look like a route change and cleared load timing.
+    location: text(stop.location) || destinationYard || address,
     dropoffKey: text(dropoff.key),
     dropLocation: destinationYard,
     dropAddress: address,
diff --git a/server/src/dispatch-plan-order-projection.js b/server/src/dispatch-plan-order-projection.js
--- a/server/src/dispatch-plan-order-projection.js
+++ b/server/src/dispatch-plan-order-projection.js
@@ -352,8 +352,10 @@
     location: text(stop.location),
     dropLocation: text(stop.dropLocation ?? stop.drop_location),
     dropAddress: text(stop.dropAddress ?? stop.drop_address),
-    dropoffKey: text(stop.dropoffKey ?? stop.dropoff_key),
-    dependencyTargetRefs: stop.dependencyTargetRefs || []
+    dropoffKey: text(stop.dropoffKey ?? stop.dropoff_key)
+    // dependencyTargetRefs is a projection annotation, not a place or visit.
+    // The Dispatch page keeps its own stops between autosaves, so counting it
+    // would clear the load timing on every save of a linked PO drop.
   }));
 }
 
