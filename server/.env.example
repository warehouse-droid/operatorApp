PORT=3000
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mbbs_yard

NETSUITE_ACCOUNT_ID=
NETSUITE_CLIENT_ID=
NETSUITE_CLIENT_SECRET=
NETSUITE_REDIRECT_URI=http://localhost:3000/api/auth/netsuite/callback
NETSUITE_AUTH_URL=
NETSUITE_TOKEN_URL=
NETSUITE_REST_BASE_URL=
NETSUITE_SCOPES=rest_webservices
# Optional. If blank, a random 256-bit master key is created in /app/data.
NETSUITE_M2M_STORAGE_SECRET=
NETSUITE_M2M_SETTINGS_PATH=/app/data/netsuite-m2m-settings.json
NETSUITE_M2M_MASTER_KEY_PATH=/app/data/.netsuite-m2m-master-key
NETSUITE_REQUEST_TIMEOUT_MS=120000
NETSUITE_WEBHOOK_SECRET=
NETSUITE_IFIR_WEBHOOK_SECRET=
NETSUITE_IFIR_WEBHOOK_SIGNATURE_MAX_AGE_SECONDS=300

GOOGLE_MAPS_API_KEY=
TRANSFER_DEPENDENCY_150_PENALTY_MINUTES=60
# Special Item SO creation remains database-gated off until these NetSuite
# mappings are reviewed. Delivery is currently NetSuite delivery method 2.
SPECIAL_STOCK_DELIVERY_METHOD_ID=2
SPECIAL_STOCK_PICKUP_METHOD_ID=
SPECIAL_STOCK_SUBSIDIARY_ID=
DISPATCH_DRIVER_ORIENTED_PLANNING=true
# Independent server-side rollout gates: off, shadow, or on. No PWA asset change is required.
DISPATCH_PLANNER_ORDER_POOL_MODE=off
DISPATCH_PLANNER_COMMAND_MODE=off
# Optional visible Web Push for pending Driver route-change requests.
# Generate a VAPID pair once; keep the private key only in the runtime env.
DRIVER_ROUTE_PUSH_VAPID_PUBLIC_KEY=
DRIVER_ROUTE_PUSH_VAPID_PRIVATE_KEY=
DRIVER_ROUTE_PUSH_VAPID_SUBJECT=mailto:operations@example.com
# Temporary no-login mode for /sales; set false to restore Sales authentication.
SALES_PUBLIC_ACCESS_ENABLED=true
NETSUITE_DIRECT_ACCESS_ENABLED=true

# Smart SCM stays in mock mode unless both the database setting and this gate enable live execution.
SMART_SCM_INPUT_DIR=/app/data/scm-inputs
SMART_SCM_PRINT_DIR=/app/data/scm-print-jobs
SMART_SCM_MAX_INPUT_MB=30
SMART_SCM_LIVE_EXECUTION_ENABLED=true
SMART_SCM_PICKING_TICKET_RESTLET_URL=
SMART_SCM_TICK_INTERVAL_MINUTES=15

# disabled: no relay; source: port 3000; consumer: isolated V2
NETSUITE_MIRROR_ROLE=disabled
NETSUITE_MIRROR_SHARED_SECRET=
NETSUITE_MIRROR_SOURCE_URL=
NETSUITE_MIRROR_CONSUMER_URL=
NETSUITE_MIRROR_RELAY_INTERVAL_MS=5000
NETSUITE_MIRROR_POLL_INTERVAL_MS=30000
NETSUITE_MIRROR_RECONCILE_INTERVAL_MS=21600000
NETSUITE_MIRROR_REQUEST_TIMEOUT_MS=15000
NETSUITE_MIRROR_SIGNATURE_MAX_AGE_SECONDS=300
NETSUITE_MIRROR_PAGE_SIZE=100

SAMSARA_API_TOKEN=
SAMSARA_DVIR_AUTHOR_ID=
SAMSARA_WRITES_ENABLED=true

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct
